{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://raw.githubusercontent.com/ros-infrastructure/answers-archive/latest/data/archive.schema.json",
	"title": "Archive",
	"description": "Schema defining the database export used for creating a static site archive",
	"type": "object",
	"properties": {
		"Questions": {
			"description": "Questions exported from the site database",
			"type": "array",
			"items": {
				"type": "object",
				"description": "Question from the original site",
				"properties": {
					"OriginalPostID": {
						"type": "number"
					},
					"Title": {
						"type": "string"
					},
					"Owner": {
						"$ref": "#/$defs/User"
					},
					"CreationDate": {
						"type": "string"
					},
					"BodyMarkdown": {
						"type": "string"
					},
					"Tags": {
						"type": "string"
					},
					"UpvoteCount": {
						"type": "number"
					},
					"OriginalPostURL": {
						"type": "string"
					},
					"Comments": {
						"$ref": "#/$defs/Comments"
					},
					"Answers": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"Owner": {
									"$ref": "#/$defs/User"
								},
								"OriginalPostID": {
									"type": "number"
								},
								"Accepted": {
									"type": "boolean"
								},
								"CreationDate": {
									"type": "string"
								},
								"BodyMarkdown": {
									"type": "string"
								},
								"UpvoteCount": {
									"type": "number"
								},
								"Comments": {
									"$ref": "#/$defs/Comments"
								}
							},
							"required": [
								"OriginalPostID", "Owner", "Accepted", "CreationDate", "BodyMarkdown", "UpvoteCount", "Comments"
							]
						}
					}
				},
				"required": [
					"OriginalPostID",
					"Title",
					"Owner",
					"CreationDate",
					"BodyMarkdown",
					"Tags",
					"UpvoteCount",
					"OriginalPostURL",
					"Answers",
					"Comments"
				]
			}
		}
	},
	"$defs": {
		"Comments": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"Owner": { "$ref": "#/$defs/User" },
					"CreationDate": {
						"type": "string"
					},
					"BodyMarkdown": {
						"type": "string"
					}
				},
				"required": [
					"Owner", "CreationDate", "BodyMarkdown"
				]
			}
		},
		"User": {
			"type": "object",
			"properties": {
				"DisplayName": {
					"type": "string"
				},
				"Karma": {
					"type": "number"
				},
				"ProfileUrl": {
					"type": "string"
				},
				"ID": {
					"type": "string"
				},
				"UserName": {
					"type": "string"
				}
			},
			"required": ["DisplayName", "ProfileUrl", "Karma", "UserName", "ID"]
		}
	}
}
