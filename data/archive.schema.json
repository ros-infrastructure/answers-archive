{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://raw.githubusercontent.com/ros-infrastructure/answers-archive/latest/data/archive.schema.json",
	"title": "Archive",
	"description": "Schema defining the database export used for creating a static site archive",
	"type": "object",
	"properties": {
		"Questions": {
			"description": "Questions exported from the site database",
			"type": "array",
			"items": {
				"type": "object",
				"description": "Question from the original site",
				"properties": {
					"OriginalPostID": {
						"type": "number"
					},
					"Title": {
						"type": "string"
					},
					"OwnerDisplayName": {
						"type": "string"
					},
					"OwnerProfileUrl": {
						"type": "string"
					},
					"CreationDate": {
						"type": "string"
					},
					"BodyMarkdown": {
						"type": "string"
					},
					"Tags": {
						"type": "string"
					},
					"UpvoteCount": {
						"type": "number"
					},
					"OriginalPostURL": {
						"type": "string"
					},
					"Answers": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"OriginalPostID": {
									"type": "number"
								},
								"OwnerDisplayName": {
									"type": "string"
								},
								"OwnerProfileUrl": {
									"type": "string"
								},
								"Accepted": {
									"type": "boolean"
								},
								"CreationDate": {
									"type": "string"
								},
								"BodyMarkdown": {
									"type": "string"
								},
								"UpvoteCount": {
									"type": "number"
								},
								"Comments": {
									"type": "array",
									"items": {
										"type": "object",
										"properties": {
											"OwnerDisplayName": {
												"type": "string"
											},
											"OwnerProfileUrl": {
												"type": "string"
											},
											"CreationDate": {
												"type": "string"
											},
											"BodyMarkdown": {
												"type": "string"
											}
										},
										"required": [
											"OwnerDisplayName", "OwnerProfileUrl", "CreationDate", "BodyMarkdown"
										]
									}
								}
							},
							"required": [
								"OriginalPostID", "OwnerDisplayName", "OwnerProfileUrl", "Accepted", "CreationDate", "BodyMarkdown", "UpvoteCount", "Comments"
							]
						}
					},
					"Comments": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"OwnerDisplayName": {
									"type": "string"
								},
								"OwnerProfileUrl": {
									"type": "string"
								},
								"CreationDate": {
									"type": "string"
								},
								"BodyMarkdown": {
									"type": "string"
								}
							},
							"required": [
								"OwnerDisplayName", "OwnerProfileUrl", "CreationDate", "BodyMarkdown"
							]
						}
					}
				},
				"required": [
					"OriginalPostID",
					"Title",
					"OwnerDisplayName",
					"OwnerProfileUrl",
					"CreationDate",
					"BodyMarkdown",
					"Tags",
					"UpvoteCount",
					"OriginalPostURL",
					"Answers",
					"Comments"
				]
			}
		}
	}
}
