{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://raw.githubusercontent.com/ros-infrastructure/answers-archive/latest/data/migration.schema.json",
	"title": "Migration",
	"description": "Schema defining the mapping of answers migrated to Robotics Stack Exchange",
	"type": "object",
	"properties": {
		"Posts": {
			"description": "Posts migrated to Robotics Stack Exchange",
			"type": "array",
			"items": {
				"type": "object",
				"description": "Posts and their migrated url",
				"properties": {
					"OriginalPostID": {
						"type": "number"
					},
					"NewUrl": {
						"type": "string"
					}
				},
				"required": [ "OriginalPostID", "NewUrl" ]
			}
		}
	}
}
