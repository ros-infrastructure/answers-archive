VERSION 0.8

bundle:
  FROM docker.io/library/ruby:3.2
  COPY --dir Gemfile Gemfile.lock /src/site
  WORKDIR /src/site
  RUN bundle install

checkout:
  ARG CONTENT=gazebo
  LOCALLY
  # RUN git checkout .
  RUN git clean -fx content/question/ nanoc.yaml
  RUN git restore --source ${CONTENT}-content content/question/
  RUN git show ${CONTENT}-content:content_config.yml >> nanoc.yaml

content:
  FROM +bundle
  COPY --dir content/ layouts/ lib/ Rules README.md nanoc.yaml /src/site

compile:
  FROM +content
  RUN bundle exec nanoc compile
  SAVE ARTIFACT output/ AS LOCAL output
